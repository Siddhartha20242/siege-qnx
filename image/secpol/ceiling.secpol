# Siege security policy 'ceiling'. Generated by tools/gen_secpol.py; edit that, not this.

type default;
type det_t;     # the detector (and its supervisor): owner of the pipeline's service channel
type atk_t;     # the untrusted neighbour: the attacker programs

# The pipeline, the shell and the harness keep every ability, as before any policy.
allow default self:ability {
    nonroot
    spawn_setuid
    spawn_setgid
    setuid
    setgid
    getid
    pathspace
    reboot
    cpumode
    runstate
    confset
    rsrcdbmgr
    session
    umask
    event
    rlimit
    mem_add
    mem_phys
    mem_special
    mem_global
    mem_peer
    mem_lock
    spawn
    fork
    prot_exec
    wait
    msg_queue
    clockset
    dumper
    interrupt
    io
    trace
    priority
    connection
    schedule
    signal
    timer
    pgrp
    map_fixed
    path_trust
    swap
    rconstraint
    child_newapp
    public_channel
    aps_root
    able_create
    runstate_burst
    default_timer_tolerance
    xprocess_query
    chroot
    power
    prot_write_and_exec
    srandom
    rlimit_peer
    mac_policy
    xprocess_able
    xprocess_debug
    xprocess_mem_read
    high_resolution_timer
    untrusted_exec
    server_monitor
    sigev_thread
    privreg
    mountifs
    settypeid:atk_t,det_t
    gain_priv:channel_connect
};
allow_attach default /...;
allow det_t self:ability {
    nonroot
    spawn_setuid
    spawn_setgid
    setuid
    setgid
    getid
    pathspace
    reboot
    cpumode
    runstate
    confset
    rsrcdbmgr
    session
    umask
    event
    rlimit
    mem_add
    mem_phys
    mem_special
    mem_global
    mem_peer
    mem_lock
    spawn
    fork
    prot_exec
    wait
    msg_queue
    clockset
    dumper
    interrupt
    io
    trace
    priority
    connection
    schedule
    signal
    timer
    pgrp
    map_fixed
    path_trust
    swap
    rconstraint
    child_newapp
    public_channel
    aps_root
    able_create
    runstate_burst
    default_timer_tolerance
    xprocess_query
    chroot
    power
    prot_write_and_exec
    srandom
    rlimit_peer
    mac_policy
    xprocess_able
    xprocess_debug
    xprocess_mem_read
    high_resolution_timer
    untrusted_exec
    server_monitor
    sigev_thread
    privreg
    mountifs
};
allow_attach det_t /...;
# The camera and controller (type default) send to the detector's channel.
allow default det_t:channel connect;
allow det_t default:channel connect;
allow det_t det_t:channel connect;    # the supervisor checks the detector it started
allow det_t atk_t:channel connect;    # the supervisor's owner check opens whatever holds the name
allow atk_t atk_t:channel connect;

# What the untrusted neighbour may do.
allow atk_t self:ability {
    nonroot
    spawn_setuid
    spawn_setgid
    setuid
    setgid
    getid
    pathspace
    reboot
    cpumode
    runstate
    confset
    rsrcdbmgr
    session
    umask
    event
    rlimit
    mem_add
    mem_phys
    mem_special
    mem_global
    mem_peer
    mem_lock
    spawn
    fork
    prot_exec
    wait
    msg_queue
    clockset
    dumper
    interrupt
    io
    trace
    connection
    schedule
    signal
    timer
    pgrp
    map_fixed
    path_trust
    swap
    rconstraint
    child_newapp
    public_channel
    aps_root
    able_create
    runstate_burst
    default_timer_tolerance
    xprocess_query
    chroot
    power
    prot_write_and_exec
    srandom
    rlimit_peer
    mac_policy
    xprocess_able
    xprocess_debug
    xprocess_mem_read
    high_resolution_timer
    untrusted_exec
    server_monitor
    sigev_thread
    privreg
    mountifs
    priority:1-9
};
allow_attach atk_t /...;
allow atk_t det_t:channel connect;
